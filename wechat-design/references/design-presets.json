  "layout_modes": {
    "chapter": {
      "_description": "章节标题的编号和装饰风格",
      "options": {
        "numbered": {
          "name": "数字编号",
          "desc": "01. ENGLISH  [ 中文标签 ] — 当前默认",
          "wechat_safe": true
        },
        "roman": {
          "name": "罗马数字",
          "desc": "i. english  [ 中文标签 ] — 适合文学性内容",
          "wechat_safe": true
        },
        "jumbo": {
          "name": "大数字入口",
          "desc": "72px 大数字 + 1px 全宽发丝线 — 适合艺术/设计内容",
          "wechat_safe": true
        },
        "simple": {
          "name": "纯中文",
          "desc": "仅 20px bold 中文标题，无编号 — 最简洁",
          "wechat_safe": true
        }
      }
    },
    "header": {
      "_description": "文章头部区块样式",
      "options": {
        "standard": {
          "name": "标准",
          "desc": "浅底标签 + 38px 衬线标题 + 英文副标题 + 30px 装饰线 — 当前默认",
          "wechat_safe": true
        },
        "dark-block": {
          "name": "深色块",
          "desc": "独立深底 table 块 + 亮色标签(MONO) + 36px 金色装饰线 + 亮色标题 — 需色板提供 bg_dark/text_on_dark",
          "wechat_safe": true,
          "requires_colors": ["bg_dark", "text_on_dark"]
        },
        "minimal": {
          "name": "极简",
          "desc": "无栏目标签、无装饰线，仅衬线标题 + 副标题 — 适合个人随笔",
          "wechat_safe": true
        }
      }
    },
    "card": {
      "_description": "引用块/信息卡片的形状",
      "options": {
        "sharp": {
          "name": "直角",
          "desc": "border-radius: 0 — 当前默认",
          "wechat_safe": true
        },
        "rounded": {
          "name": "圆角",
          "desc": "border-radius: 14px — Soft Editorial 风格",
          "wechat_safe": true
        },
        "pill": {
          "name": "药丸",
          "desc": "border-radius: 999px — 仅用于标签/按钮等小元素",
          "wechat_safe": true
        }
      }
    },
    "quote": {
      "_description": "引用块样式",
      "options": {
        "left-border": {
          "name": "左边框",
          "desc": "border-left: 3px solid accent — 当前默认",
          "wechat_safe": true
        },
        "outlined": {
          "name": "描边",
          "desc": "全边框 1.5px solid accent，透明背景 — Long Table 风格",
          "wechat_safe": true
        },
        "filled": {
          "name": "实色填充",
          "desc": "accent_bg 实色背景 + 可选圆角 — 更醒目的引用",
          "wechat_safe": true
        }
      }
    },
    "bullet": {
      "_description": "列表标记符号",
      "options": {
        "dot": {
          "name": "圆点",
          "desc": "· — 当前默认",
          "wechat_safe": true
        },
        "dash": {
          "name": "全角破折号",
          "desc": "— em-dash 替换圆点 — Signal 风格，更克制",
          "wechat_safe": true
        },
        "numbered-mono": {
          "name": "等宽编号",
          "desc": "用等宽字体数字计数 — Vellum 风格（需手动维护编号）",
          "wechat_safe": true
        }
      }
    },
    "divider": {
      "_description": "分隔线样式",
      "options": {
        "accent-short": {
          "name": "短强调线",
          "desc": "30px × 1px accent 色 — 当前默认",
          "wechat_safe": true
        },
        "gold-rule": {
          "name": "金线",
          "desc": "36px × 1px — Signal 风格",
          "wechat_safe": true
        },
        "hairline-full": {
          "name": "全宽发丝线",
          "desc": "100% × 1px — Biennale Yellow 风格",
          "wechat_safe": true
        },
        "dashed": {
          "name": "虚线",
          "desc": "1px dashed — Long Table 风格",
          "wechat_safe": true
        }
      }
    },
    "emphasis": {
      "_description": "正文内强调方式（**bold** 渲染为）",
      "options": {
        "bold-dark": {
          "name": "深色加粗",
          "desc": "color: title + font-weight: bold — 当前默认",
          "wechat_safe": true
        },
        "color-switch": {
          "name": "颜色切换",
          "desc": "换用 accent 色或 accent_bright 色 — CJK 无 italic 轴的补偿策略",
          "wechat_safe": true
        },
        "mark-highlight": {
          "name": "荧光笔",
          "desc": "background-color: accent + padding: 0 4px — 仅对 !!text 语法触发",
          "wechat_safe": true
        }
      }
    },
    "density": {
      "_description": "内容密度/段落间距",
      "options": {
        "sparse": {
          "name": "宽松",
          "desc": "段落间距 24px，章节间距 80px",
          "wechat_safe": true,
          "paragraph_gap": 24
        },
        "normal": {
          "name": "标准",
          "desc": "段落间距 16px，章节间距 60px — 当前默认",
          "wechat_safe": true,
          "paragraph_gap": 16
        },
        "dense": {
          "name": "紧凑",
          "desc": "段落间距 8px，章节间距 40px — 信息密度优先",
          "wechat_safe": true,
          "paragraph_gap": 8
        }
      }
    },
    "alignment": {
      "_description": "文章整体对齐",
      "options": {
        "justify": {
          "name": "两端对齐",
          "desc": "text-align: justify — 当前默认，适合中文长文",
          "wechat_safe": true
        },
        "left": {
          "name": "左对齐",
          "desc": "text-align: left — 更现代，适合短段落",
          "wechat_safe": true
        },
        "center": {
          "name": "居中",
          "desc": "text-align: center — 仅适合特殊场景（Vellum 风格）",
          "wechat_safe": true
        }
      }
    }
  },

  "defaults": {
